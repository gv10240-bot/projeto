diff -ruN a/src/dxvk/dxvk_diag.h c/src/dxvk/dxvk_diag.h
--- a/src/dxvk/dxvk_diag.h	1970-01-01 00:00:00.000000000 +0000
+++ c/src/dxvk/dxvk_diag.h	2026-10-10 12:39:23.914530594 +0000
@@ -0,0 +1,151 @@
+#pragma once
+
+#include <atomic>
+#include <cctype>
+#include <cstdint>
+#include <cstring>
+#include <set>
+#include <string>
+#include <vector>
+
+#include "../util/log/log.h"
+#include "../util/util_env.h"
+#include "../util/util_string.h"
+
+namespace dxvk {
+
+  /**
+   * \brief Diagnostic ring buffer
+   *
+   * Remembers which shaders were bound recently and, when the
+   * GPU is lost, prints the ones that belong to the command
+   * list that most likely caused the failure.
+   */
+  class DxvkDiag {
+    constexpr static uint32_t RingSize = 4096;
+    constexpr static uint32_t TextSize = 300;
+
+    struct Entry {
+      uint64_t seq;
+      char     text[TextSize];
+    };
+
+  public:
+
+    /** Remember a shader binding for the command list being recorded */
+    static void record(const std::string& text) {
+      uint64_t idx = head.fetch_add(1, std::memory_order_relaxed);
+      Entry& e = ring[idx % RingSize];
+      e.seq = submitted.load(std::memory_order_relaxed) + 1;
+      std::strncpy(e.text, text.c_str(), TextSize - 1);
+      e.text[TextSize - 1] = '\0';
+    }
+
+    /** A command list was handed to the submission queue */
+    static void markSubmitted() {
+      submitted.fetch_add(1, std::memory_order_relaxed);
+    }
+
+    /** A command list finished on the GPU without errors */
+    static void markFinished() {
+      finished.fetch_add(1, std::memory_order_relaxed);
+    }
+
+    /**
+     * \brief Checks the shader names against DXVK_SKIP_SHADERS
+     *
+     * DXVK_SKIP_SHADERS is a list of text pieces (for example the
+     * first 8 characters of a shader hash), separated by commas.
+     * Draws and dispatches that use a matching shader are skipped.
+     * Only meant to be called from the context thread.
+     */
+    static bool matchesSkip(const std::string& names) {
+      static const std::vector<std::string> list = parseSkipList();
+
+      if (list.empty())
+        return false;
+
+      std::string lower = names;
+      for (char& c : lower)
+        c = char(std::tolower((unsigned char)c));
+
+      for (const std::string& item : list) {
+        if (lower.find(item) != std::string::npos) {
+          static std::set<std::string> logged;
+
+          if (logged.insert(names).second)
+            Logger::err(str::format("DIAG: skipping draws that use: ", names));
+
+          return true;
+        }
+      }
+
+      return false;
+    }
+
+    /** Print the suspect command lists. Runs only once. */
+    static void dump() {
+      bool expected = false;
+      if (!dumped.compare_exchange_strong(expected, true))
+        return;
+
+      uint64_t fin = finished.load();
+      uint64_t sub = submitted.load();
+      uint64_t bad = fin + 1;
+
+      Logger::err(str::format("DIAG: GPU lost. command lists submitted=", sub,
+        " finished_ok=", fin, " suspect=#", bad, " (also showing #", bad - 1, " and #", bad + 1, ")"));
+
+      uint64_t h = head.load();
+      uint64_t n = h < RingSize ? h : RingSize;
+      uint64_t printed = 0;
+
+      for (uint64_t i = h - n; i < h && printed < 400; i++) {
+        const Entry& e = ring[i % RingSize];
+
+        if (e.seq + 1 >= bad && e.seq <= bad + 1) {
+          Logger::err(str::format("DIAG list#", e.seq, ": ", e.text));
+          printed += 1;
+        }
+      }
+
+      Logger::err("DIAG: end of dump");
+    }
+
+    inline static bool skipGfx = false;
+    inline static bool skipCs  = false;
+
+  private:
+
+    static std::vector<std::string> parseSkipList() {
+      std::vector<std::string> result;
+      std::string env = env::getEnvVar("DXVK_SKIP_SHADERS");
+      std::string cur;
+
+      for (size_t i = 0; i <= env.size(); i++) {
+        char c = i < env.size() ? env[i] : ',';
+
+        if (c == ',' || c == ';' || c == ' ') {
+          if (!cur.empty())
+            result.push_back(cur);
+          cur.clear();
+        } else {
+          cur.push_back(char(std::tolower((unsigned char)c)));
+        }
+      }
+
+      if (!result.empty())
+        Logger::err(str::format("DIAG: DXVK_SKIP_SHADERS has ", result.size(), " entries"));
+
+      return result;
+    }
+
+    inline static Entry                 ring[RingSize];
+    inline static std::atomic<uint64_t> head      { 0 };
+    inline static std::atomic<uint64_t> submitted { 0 };
+    inline static std::atomic<uint64_t> finished  { 0 };
+    inline static std::atomic<bool>     dumped    { false };
+
+  };
+
+}
