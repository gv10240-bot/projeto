+  // Applies options from $DXVK_CONFIG, formatted as
+  // "option = value; other.option = value"
+  static void applyEnvConfig(Config& config) {
+    std::string env = env::getEnvVar("DXVK_CONFIG");
+
+    if (env.empty())
+      return;
+
+    Logger::info(str::format("Applying DXVK_CONFIG: ", env));
+
+    ConfigContext ctx;
+    ctx.active = true;
+
+    size_t pos = 0;
+
+    while (pos <= env.size()) {
+      size_t end = env.find(';', pos);
+
+      if (end == std::string::npos)
+        end = env.size();
+
+      parseUserConfigLine(config, ctx, env.substr(pos, end - pos));
+      pos = end + 1;
+    }
+  }
+
